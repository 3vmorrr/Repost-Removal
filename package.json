{
  "name": "repost-remover-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first TikTok repost review and removal desktop application",
  "author": "Omar Ebrahim",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "build": {
    "appId": "com.omar.repostremover",
    "productName": "Repost Remover",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
